Temp_MapaOrcado:
load 
	Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede as ChaveOrc,
    CPV_Unit_Sem_Imposto, 
	CPV_Fixo, 
    CPV_Variavel, 
    CPV_Variavel_Sem_Imposto
Resident DRE
Where Base = 'Orçado';

CPVOrcadoMapSemImposto:
Mapping Load ChaveOrc, CPV_Unit_Sem_Imposto Resident Temp_MapaOrcado Where not IsNull(CPV_Unit_Sem_Imposto);

CPVFixoOrcadoMap:
Mapping Load ChaveOrc, CPV_Fixo Resident Temp_MapaOrcado Where not IsNull(CPV_Fixo);

CPVVarOrcadoMap:
Mapping Load ChaveOrc, CPV_Variavel Resident Temp_MapaOrcado Where not IsNull(CPV_Variavel);

CPVVarOrcadoMapSemImposto:
Mapping Load ChaveOrc, CPV_Variavel_Sem_Imposto Resident Temp_MapaOrcado Where not IsNull(CPV_Variavel_Sem_Imposto);

Drop Table Temp_MapaOrcado;

ForecastCorteMap:
Mapping Load BaseForecast, DataCorte Resident ForecastCorte;

Temp_Bases:
Load Distinct BaseForecast Resident ForecastCorte;

Let vNumBases = NoOfRows('Temp_Bases');

Fato_PVM_RealizadoSnapshot:
NoConcatenate
Load *
Resident Fato_PVM
Where Base = 'Realizado';

For i = 0 to $(vNumBases) - 1
    Let vBaseAtual = Peek('BaseForecast', $(i), 'Temp_Bases');
    Let vCorteAtual = Num(ApplyMap('ForecastCorteMap', '$(vBaseAtual)'));

    DRE_ForecastAtual:
    NoConcatenate
    Load *
    Resident DRE
    Where Base = '$(vBaseAtual)' and Num(Data) >= $(vCorteAtual);



Agg_Fc_ComImposto:
         Load
        Data, Canal, UF, Código, Divisional, Rede, Base,
        Sum(ReceitaLiquida) as ReceitaLiquida_PVM,
        Sum(ReceitaLiquida) + Sum([CPV Un Orçado Final] * Quantidade) as LucroBruto_PVM,
        Sum([CPV Un Orçado Final] * Quantidade) as CPV_PVM, 
        Sum(ApplyMap('CPVFixoOrcadoMap',
            Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede, 0) * Quantidade) as CPV_Fixo_PVM,
        Sum(ApplyMap('CPVVarOrcadoMap',
            Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede, 0) * Quantidade) as CPV_Var_PVM,
        Sum("Imposto Orçado Final") as Imposto_PVM              
       Resident DRE_ForecastAtual
       Group By Data, Canal, UF, Código, Divisional, Rede, Base;
    
    Tipos_Fc_ComImposto:
    NoConcatenate
    Load * Inline [
    TypePVM
    PVM Preço Margem
    PVM Receita Bruta
    PVM Receita Líquida
    PVM Custo - C/ Imposto ñ Recuperado
    PVM Custo Margem - C/ Imposto ñ Recuperado
    ];
    
     Join (Tipos_Fc_ComImposto)
    Load * Resident Agg_Fc_ComImposto;

    Concatenate(Fato_PVM)
    Load * Resident Tipos_Fc_ComImposto;

    Drop Tables Agg_Fc_ComImposto, Tipos_Fc_ComImposto;

    Agg_Fc_SemImposto:
        Load
            Data, Canal, UF, Código, Divisional, Rede, Base,
            Sum(ReceitaLiquida) as ReceitaLiquida_PVM,
            Sum(ReceitaLiquida) +
                Sum(ApplyMap('CPVOrcadoMapSemImposto',
                    Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede, 0) * Quantidade)
                as LucroBruto_PVM, 
                Sum(ApplyMap('CPVOrcadoMapSemImposto',
                    Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede, 0) * Quantidade) as CPV_PVM,
                Sum(ApplyMap('CPVFixoOrcadoMap',
            		Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede, 0) * Quantidade) as CPV_Fixo_PVM,
        		Sum(ApplyMap('CPVVarOrcadoMapSemImposto',
            		Data&'|'&Canal&'|'&UF&'|'&Código&'|'&Divisional&'|'&Rede, 0) * Quantidade) as CPV_Var_PVM,
                 Sum("Imposto Orçado Final") as Imposto_PVM
                

        Resident DRE_ForecastAtual
        Group By Data, Canal, UF, Código, Divisional, Rede, Base;
    Tipos_Fc_SemImposto:
    NoConcatenate
        Load * Inline [
        TypePVM
        PVM Custo - S/ Imposto ñ Recuperado
        PVM Custo Margem - S/ Imposto ñ Recuperado
        ];

        Join (Tipos_Fc_SemImposto)
        Load * Resident Agg_Fc_SemImposto;

        Concatenate(Fato_PVM)
        Load * Resident Tipos_Fc_SemImposto;

        Drop Tables Agg_Fc_SemImposto, Tipos_Fc_SemImposto;
        Drop Table DRE_ForecastAtual;

    // --- Meses espelhados (sem mudança) ---
        Concatenate(Fato_PVM)
        Load
            TypePVM,
            Data, Canal, UF, Código, Divisional, Rede,
            '$(vBaseAtual)' as Base,
            ReceitaLiquida_PVM,
            LucroBruto_PVM,
            CPV_PVM, 
            CPV_Fixo_PVM, 
            CPV_Var_PVM,
            Imposto_PVM
         Resident Fato_PVM_RealizadoSnapshot
         Where Num(Data) < $(vCorteAtual);
Next i

Drop Table Fato_PVM_RealizadoSnapshot;
Drop Table Temp_Bases;
Drop Table ForecastCorte;

MateriaisFinal:
LOAD Distinct
    CodMaterial as Código, 
    Material as "Descrição Material",
    Marca, 
    CodMaterial&' | '&Material as "Material + Descrição"
FROM [lib://Controladoria:DataFiles/Materiais.qvd] (qvd);

Concatenate(MateriaisFinal)
LOAD 
    Trim(Código) as Código, 
    Trim("Descrição Material") as "Descrição Material", 
    Trim(Marca) as Marca, 
    Trim("Material + Descrição") as "Material + Descrição"
FROM [lib://Controladoria:DataFiles/Exceções.xlsx]
(ooxml, embedded labels, table is Material);

Left Join(Fato_PVM)
LOAD * Resident MateriaisFinal;

Drop Table MateriaisFinal;
