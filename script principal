Agg_Real_A:
load 
	Data, Canal, UF, Código, Divisional, Rede, Base,
    Sum(ReceitaLiquida) as ReceitaLiquida_PVM,
    Sum(LucroBruto) as LucroBruto_PVM,
    Sum([CPV]) as CPV_PVM,
   	Sum(CPV_Fixo_Inteiro) as CPV_Fixo_PVM,
  	Sum(CPV_Variavel_Inteiro) as CPV_Var_PVM, 
    Sum(Imposto) as Imposto_PVM
Resident DRE
Where Base = 'Realizado' 
Group By Data, Canal, UF, Código, Divisional, Rede, Base;

Tipo_A:
NoConcatenate
load * inline [
TypePVM
PVM Receita Bruta
PVM Receita Líquida
];

Join(Tipo_A)
load * Resident Agg_Real_A;

Fato_PVM:
NoConcatenate
Load * Resident Tipo_A;

Drop table Agg_Real_A, Tipo_A;

Concatenate(Fato_PVM)
load 
	'PVM Preço Margem' as TypePVM, 
    Data, Canal, UF, Código, Divisional, Rede, Base,
    Sum(ReceitaLiquida) as ReceitaLiquida_PVM,
    Sum(ReceitaLiquida) + Sum([CPV Orçado]) as LucroBruto_PVM, 
    Sum([CPV Orçado]) as CPV_PVM, 
	Sum([CPV Fixo Orçado]) as CPV_Fixo_PVM,
  	Sum([CPV Var Orçado]) as CPV_Var_PVM, 
    Sum(Imposto) as Imposto_PVM
Resident DRE
Where Base = 'Realizado' 
Group By Data, Canal, UF, Código, Divisional, Rede, Base;

